<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_due_soon" model="mail.template">
        <field name="name">Task: due tomorrow</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="subject">Due tomorrow: {{ object.name }}</field>
        <field name="body_html" type="html">
<div>
    <p>Hi <t t-out="', '.join(object.user_ids.mapped('name'))"/>,</p>
    <p>
        <strong t-out="object.name"/> in <t t-out="object.project_id.name"/> is due
        <strong t-out="format_datetime(object.date_deadline, tz=object.user_ids[:1].tz, dt_format='EEEE, MMM d, h:mm a')"/>.
    </p>
    <p><a t-att-href="'%s/mail/view?model=project.task&amp;res_id=%s' % (object.get_base_url(), object.id)">Open the task</a></p>
</div>
        </field>
    </record>

    <record id="mail_template_escalation" model="mail.template">
        <field name="name">Task: overdue, escalate to project manager</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="subject">Overdue 2+ days: {{ object.name }}</field>
        <field name="body_html" type="html">
<div>
    <p>Hi <t t-out="object.project_id.user_id.name"/>,</p>
    <p>
        <strong t-out="object.name"/> in <t t-out="object.project_id.name"/> was due
        <t t-out="format_datetime(object.date_deadline, tz=object.project_id.user_id.tz, dt_format='EEEE, MMM d, h:mm a')"/>
        and is still open.
    </p>
    <p>Assigned to: <t t-out="', '.join(object.user_ids.mapped('name')) or 'nobody'"/></p>
    <p><a t-att-href="'%s/mail/view?model=project.task&amp;res_id=%s' % (object.get_base_url(), object.id)">Open the task</a></p>
</div>
        </field>
    </record>

    <!-- Rendered once per person by ProjectTask._cron_send_overdue_digest, which passes the tasks in ctx. -->
    <record id="mail_template_overdue_digest" model="mail.template">
        <field name="name">Daily overdue summary (per person)</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="email_from">{{ object.company_id.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="subject">You have {{ len(ctx.get('overdue_tasks', [])) }} overdue task(s)</field>
        <field name="body_html" type="html">
<div>
    <p>Hi <t t-out="object.name"/>,</p>
    <p>These tasks are past their deadline. You'll get this summary every morning until they're done.</p>
    <ul>
        <li t-foreach="ctx.get('overdue_tasks', [])" t-as="task">
            <a t-att-href="'%s/mail/view?model=project.task&amp;res_id=%s' % (task.get_base_url(), task.id)" t-out="task.name"/>
            (<t t-out="task.project_id.name"/>), due
            <t t-out="format_datetime(task.date_deadline, tz=object.tz, dt_format='MMM d, h:mm a')"/>
        </li>
    </ul>
</div>
        </field>
    </record>
</odoo>
